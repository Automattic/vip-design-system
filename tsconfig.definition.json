{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Produce .d.ts declaration files. Must be enabled via command-line flags
    // since noEmit=true in this file. See `npm run build:types` script.
    "declaration": true,

    // Output directory for declaration files.
    "outDir": "build/system"
  },
  "include": [ "src" ],
  // Stories and tests are not published, so emit no declarations for them.
  "exclude": [ "src/**/*.stories.*", "src/**/*.test.*", "src/system/utils/stories" ]
}
