{
	"extends": "generic",
	"designSystem": {
		"name": "VIP Design System v3",
		"packages": ["@automattic/vip-design-system"],
		"tokenPrefixes": [
			"--color-",
			"--space-",
			"--layout-",
			"--size-",
			"--font-",
			"--line-height-",
			"--letter-spacing-",
			"--border-",
			"--radius-",
			"--shadow-",
			"--stroke-",
			"--focus",
			"--transparent",
			"--black",
			"--pure-",
			"--gray-",
			"--blue-",
			"--gold-",
			"--green-",
			"--orange-",
			"--parsely-green-",
			"--pink-",
			"--purple-",
			"--red-",
			"--salmon-",
			"--yellow-",
			"--box-",
			"--stack-",
			"--cluster-",
			"--repel-",
			"--grid-",
			"--sidebar-",
			"--switcher-",
			"--reel-",
			"--cover-",
			"--frame-",
			"--wrapper-",
			"--with-icon-",
			"--flow-",
			"--region-",
			"--badge-",
			"--banner-",
			"--button-",
			"--checkbox-",
			"--code-",
			"--console-",
			"--input-",
			"--notice-",
			"--option-row-",
			"--radio-",
			"--slider-",
			"--snackbar-",
			"--sticker-",
			"--tag-",
			"--toggle-",
			"--toolbar-"
		],
		"tokenSources": [
			"node_modules/@automattic/vip-design-system/dist/css/index.css",
			"node_modules/@automattic/vip-design-system/dist/tokens/vars.css"
		],
		"styleSources": ["node_modules/@automattic/vip-design-system/dist/css/index.css"]
	},
	"suppression": {
		"keyword": "vip-allow",
		"blanket": ["vip-disable", "ds-disable"]
	},
	"rules": {
		"stylesheet/unparsed": "error",
		"suppression/malformed": "error",
		"tokens/unknown-token": "error",
		"tokens/hardcoded-value": "warn",
		"layout/margin-on-child": "warn",
		"layout/negative-margin": "warn",
		"typography/untokenized": "warn",
		"css/dead-class": "warn"
	}
}
