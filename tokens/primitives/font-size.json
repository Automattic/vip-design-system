{
	"font-size": {
		"0": {
			"$value": "0.6875rem",
			"$type": "dimension",
			"$description": "11px — static, non-responsive"
		},
		"1": { "$value": "0.75rem", "$type": "dimension", "$description": "12px — static" },
		"2": { "$value": "0.875rem", "$type": "dimension", "$description": "14px — static" },
