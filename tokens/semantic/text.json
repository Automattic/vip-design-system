					"dark": "{gray.40}"
				}
			},
			"placeholder": {
				"$value": "{gray.55}",
				"$type": "color",
				"$description": "Input placeholder text.",
				"$extensions": {
					"dark": "{gray.45}"
				}
			},
			"disabled": {
				"$value": "{gray.40}",
				"$type": "color",
