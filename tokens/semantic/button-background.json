			"display": {
				"$value": "{gold.30}",
				"$type": "color",
				"$description": "Display/hero button fill.",
				"$extensions": {
					"dark": "{gold.40}"
				}
			},
			"hover-default": {
				"$value": "{gold.30}",
				"$type": "color",
				"$description": "Hover state for primary & secondary buttons.",
