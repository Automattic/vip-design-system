{
	"color": {
		"background": {
			"primary": {
				"$value": "{gray.0}",
				"$type": "color",
				"$description": "Use as main application background",
				"$extensions": {
					"dark": "{gray.93}"
				}
			},
			"transparent": {
				"$value": "{transparent}",
				"$type": "color",
				"$description": "Use for transparent backgrounds"
			},
			"overlay": {
				"$value": "rgb(19 25 30 / 70%)",
				"$type": "color",
				"$description": "Use for modal UI overlay",
				"$extensions": {
					"dark": "rgba({black}, 0.7)"
				}
			}
		}
	}
}
