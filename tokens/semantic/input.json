						"$value": "{gold.60}",
						"$type": "color"
					},
					"disabled": {
						"$value": "{gray.25}",
						"$type": "color",
						"$extensions": {
							"dark": "{gray.75}"
						}
					}
				}
			},
			"toggle": {
				"switch": {
					"default": {
						"$value": "{pure-white}",
						"$type": "color",
						"$extensions": {
							"dark": "{gray.7}"
						}
					},
					"disabled": {
						"$value": "{gray.7}",
						"$type": "color",
						"$extensions": {
							"dark": "{gray.50}"
						}
					}
				}
			}
		}
