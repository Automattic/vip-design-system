							"$type": "color"
						},
						"hover": {
							"$value": "{color.text.secondary}",
							"$type": "color"
						},
						"acive": {
							"$value": "{color.text.secondary}",
							"$type": "color"
						},
						"disabled": {
							"$value": "{color.text.disabled}",
							"$type": "color"
