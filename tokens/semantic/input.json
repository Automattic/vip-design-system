					"$value": "{black}",
					"$type": "color",
					"$extensions": {
						"dark": "{gray.70}"
					}
				},
				"success": {
					"$value": "{green.60}",
					"$type": "color"
				},
				"brand": {
					"$value": "{gold.60}",
					"$type": "color"
				},
				"inactive": {
					"$value": "{gray.50}",
					"$type": "color",
					"$extensions": {
						"dark": "{gray.80}"
					}
				},
				"disabled": {
					"$value": "{gray.20}",
					"$type": "color",
					"$extensions": {
						"dark": "{gray.80}"
					}
				},
				"read-only": {
					"$value": "{color.layer.1}",
					"$type": "color"
				}
			},
			"label": {
				"default": {
					"$value": "{black}",
					"$type": "color",
					"$extensions": {
						"dark": "{gray.10}"
					}
				}
			},
			"text": {
				"default": {
					"$value": "{black}",
					"$type": "color",
					"$extensions": {
						"dark": "{gray.10}"
					}
				},
				"placeholder": {
					"$value": "{gray.55}",
					"$type": "color",
					"$description": "Use for placeholder text in fields",
