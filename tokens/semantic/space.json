{
	"space": {
		"0": { "$value": "0", "$type": "dimension" },
		"1": { "$value": "{space.1}", "$type": "dimension" },
		"2": { "$value": "{space.2}", "$type": "dimension" },
		"3": { "$value": "{space.3}", "$type": "dimension" },
		"4": { "$value": "{space.4}", "$type": "dimension" },
		"5": { "$value": "{space.5}", "$type": "dimension" },
		"6": { "$value": "{space.6}", "$type": "dimension" },
		"7": { "$value": "{space.7}", "$type": "dimension" },
		"8": { "$value": "{space.8}", "$type": "dimension" },
		"9": { "$value": "{space.10}", "$type": "dimension" },
		"responsive": {
			"0": { "$value": "0", "$type": "dimension" },
			"1": { "$value": "{space.responsive.3-4}", "$type": "dimension" },
			"2": { "$value": "{space.responsive.4-5}", "$type": "dimension" },
			"3": { "$value": "{space.responsive.5-6}", "$type": "dimension" },
			"4": {
				"$value": "{space.responsive.6-7}",
				"$type": "dimension",
				"$description": "The default space between sequential blocks in a layout"
			},
			"5": { "$value": "{space.responsive.7-8}", "$type": "dimension" },
			"6": { "$value": "{space.responsive.8-9}", "$type": "dimension" },
			"7": { "$value": "{space.responsive.9-10}", "$type": "dimension" }
		}
	}
}
