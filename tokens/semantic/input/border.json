{
	"color": {
		"input": {
			"border": {
				"default": {
					"$value": "{gray.45}",
					"$type": "color",
					"$extensions": {
						"dark": "{gray.60}"
					}
				},
				"disabled": {
					"$value": "{gray.25}",
					"$type": "color",
					"$extensions": {
						"dark": "{gray.75}"
					}
				},
				"error": {
					"$value": "{red.55}",
					"$type": "color",
					"$description": "Use for inputs which are in an error state.",
					"$extensions": {
						"dark": "{red.40}"
					}
				},
				"read-only": {
					"$value": "{color.border.2}",
					"$type": "color"
				}
			}
		}
	}
}
