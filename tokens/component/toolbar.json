{
	"toolbar": {
		"background": {
			"$value": "{color.layer.inverse}",
			"$type": "color",
			"$description": "Toolbar background — dark on light, page-level on dark.",
			"$extensions": {
				"dark": "{color.layer.4}"
			}
		},
		"brand": {
			"$value": "{color.icon.inverse-primary}",
			"$type": "color",
			"$description": "Logo / wordmark color."
		},
		"text": {
			"default": {
				"$value": "{color.text.inverse-primary}",
				"$type": "color",
				"$description": "Default toolbar text and icon color.",
				"$extensions": {
					"dark": "{color.text.primary}"
				}
			},
			"hover": {
				"$value": "{color.text.inverse-primary}",
				"$type": "color",
				"$extensions": {
					"dark": "{color.text.primary}"
				}
			}
		}
	}
}
