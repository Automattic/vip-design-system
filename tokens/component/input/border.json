{
	"input": {
		"border": {
			"default": {
				"$value": "{color.input.border.default}",
				"$type": "color"
			},
			"disabled": {
				"$value": "{color.input.border.disabled}",
				"$type": "color"
			},
			"error": {
				"$value": "{color.input.border.error}",
				"$type": "color",
				"$description": "Use for inputs which are in an error state."
			},
			"read-only": {
				"$value": "{color.input.border.read-only}",
				"$type": "color"
			}
		}
	}
}
