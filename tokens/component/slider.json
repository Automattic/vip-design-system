{
	"slider": {
		"background": {
			"default": {
				"$value": "{color.control.background.disabled}",
				"$type": "color"
			},
			"disabled": {
				"$value": "{color.control.background.disabled}",
				"$type": "color"
			}
		},
		"handle": {
			"default": {
				"$value": "{color.control.background.primary}",
				"$type": "color",
				"$extensions": {
					"dark": "{color.control.foreground.primary}"
				}
			},
			"disabled": {
				"$value": "{color.control.background.inactive}",
				"$type": "color"
			}
		}
	}
}
