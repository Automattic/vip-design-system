{
	"notice-inline": {
		"variants": {
			"$extensions": {
				"com.automattic.vip.css": {
					"default": "info"
				}
			},
			"error": {
				"background": {
					"$value": "{color.support.error.background}",
					"$type": "color"
				},
				"accent": {
					"$value": "{color.support.error.accent}",
					"$type": "color"
				},
				"link": {
					"$value": "{color.support.error.link}",
					"$type": "color"
				},
				"link-hover": {
					"$value": "{color.support.error.hover}",
					"$type": "color"
				}
			},
			"warning": {
				"background": {
					"$value": "{color.support.warning.background}",
					"$type": "color"
				},
				"accent": {
					"$value": "{color.support.warning.accent}",
					"$type": "color"
				},
				"link": {
					"$value": "{color.support.warning.link}",
					"$type": "color"
				},
				"link-hover": {
					"$value": "{color.support.warning.hover}",
					"$type": "color"
				}
			},
			"success": {
				"background": {
