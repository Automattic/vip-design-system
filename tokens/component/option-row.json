{
	"option-row": {
		"default": {
			"background": {
				"$value": "{color.layer.accent}",
				"$type": "color"
			},
			"icon": {
				"$value": "{color.icon.primary}",
				"$type": "color",
				"$extensions": {
					"dark": "{color.icon.inverse}"
				}
			}
		},
		"alt": {
			"background": {
				"$value": "{color.layer.inverse}",
				"$type": "color"
			},
			"icon": {
				"$value": "{color.icon.inverse}",
				"$type": "color"
			}
		}
	}
}
