{
	"badge": {
		"variants": {
			"$extensions": {
				"com.automattic.vip.css": {
					"default": "gray",
					"aliases": {
						"system": "gray",
						"info": "blue",
						"success": "green",
						"error": "red",
						"brand": "gold",
						"warning": "yellow"
					}
				},
				"com.automattic.vip.react": {
					"element": "span",
					"className": "type-support-label-xs"
				}
			},
			"gray": {
				"background": {
					"$value": "{color.support.system.background}",
					"$type": "color"
				},
				"color": {
					"$value": "{color.text.primary}",
					"$type": "color",
					"$extensions": {
						"dark": "{color.support.system.text}"
					}
				},
				"border-color": {
					"$value": "{color.border.transparent}",
					"$type": "color",
					"$extensions": {
						"dark": "{color.support.system.text}"
					}
				}
			},
			"blue": {
				"background": {
					"$value": "{color.support.info.background}",
					"$type": "color"
				},
				"color": {
					"$value": "{color.text.primary}",
					"$type": "color",
					"$extensions": {
						"dark": "{color.support.info.text}"
					}
				},
				"border-color": {
					"$value": "{color.border.transparent}",
					"$type": "color",
					"$extensions": {
						"dark": "{color.support.info.text}"
					}
				}
			},
			"green": {
				"background": {
					"$value": "{color.support.success.background}",
					"$type": "color"
				},
				"color": {
					"$value": "{color.text.primary}",
					"$type": "color",
					"$extensions": {
						"dark": "{color.support.success.text}"
					}
				},
				"border-color": {
					"$value": "{color.border.transparent}",
					"$type": "color",
					"$extensions": {
						"dark": "{color.support.success.text}"
					}
				}
			},
			"red": {
				"background": {
					"$value": "{color.support.error.background}",
					"$type": "color"
				},
				"color": {
					"$value": "{color.text.primary}",
					"$type": "color",
					"$extensions": {
						"dark": "{color.support.error.text}"
					}
				},
				"border-color": {
					"$value": "{color.border.transparent}",
					"$type": "color",
					"$extensions": {
						"dark": "{color.support.error.text}"
					}
				}
			},
			"gold": {
				"background": {
					"$value": "{color.support.brand.background}",
					"$type": "color"
				},
				"color": {
					"$value": "{color.text.primary}",
					"$type": "color",
					"$extensions": {
						"dark": "{color.support.brand.text}"
					}
				},
				"border-color": {
					"$value": "{color.border.transparent}",
					"$type": "color",
					"$extensions": {
						"dark": "{color.support.brand.text}"
					}
				}
			},
			"yellow": {
				"background": {
					"$value": "{color.support.warning.background}",
					"$type": "color"
				},
				"color": {
					"$value": "{color.text.primary}",
					"$type": "color",
					"$extensions": {
						"dark": "{color.support.warning.text}"
					}
				},
				"border-color": {
					"$value": "{color.border.transparent}",
					"$type": "color",
					"$extensions": {
						"dark": "{color.support.warning.text}"
					}
				}
			}
		}
	}
}
