{
	"name": "@automattic/vip-design-system",
	"version": "3.0.0",
	"description": "A CSS/token-first design system for VIP projects",
	"license": "GPL-2.0-or-later",
	"type": "module",
	"main": "dist/index.cjs",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./css": "./dist/css/index.css",
		"./tokens": "./dist/tokens/vars.css"
	},
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=22.13"
	},
	"scripts": {
		"build": "npm run build:icons && npm run build:tokens && vite build",
		"build:icons": "node scripts/build-sprite.mjs",
		"icons:sync": "node scripts/sync-icons.mjs",
		"build:tokens": "node style-dictionary.config.js",
		"dev": "storybook dev -p 6006",
		"preview": "node scripts/preview-server.mjs",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"lint": "eslint src --max-warnings 0",
		"lint:fix": "eslint src --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"check-types": "tsc --noEmit && tsc -p test/types/tsconfig.json",
		"check:configuration": "node style-dictionary.config.js --check-configuration"
	},
	"peerDependencies": {
		"react": "^18.0.0",
		"react-dom": "^18.0.0"
	},
	"dependencies": {
		"@base-ui/react": "^1.9.0",
		"@boxicons/core": "^1.0.6"
	},
	"devDependencies": {
		"@eslint-react/eslint-plugin": "^5.28.8",
		"@eslint/js": "^10.0.1",
		"@storybook/addon-a11y": "^10.6.7",
		"@storybook/addon-docs": "^10.6.7",
		"@storybook/addon-links": "^10.6.7",
		"@storybook/react-vite": "^10.6.7",
		"@testing-library/jest-dom": "^6.6.3",
		"@testing-library/react": "^16.3.0",
		"@testing-library/user-event": "^14.5.2",
		"@types/react": "^18.3.23",
		"@types/react-dom": "^18.3.7",
		"@vitejs/plugin-react-swc": "^4.3.3",
		"@vitest/coverage-v8": "^5.1.0",
		"autoprefixer": "^10.4.21",
		"eslint": "^10.14.0",
		"globals": "^17.14.0",
		"jest-axe": "^9.0.0",
		"jsdom": "^26.1.0",
		"lefthook": "^1.11.13",
		"postcss": "^8.5.3",
		"postcss-import": "^16.1.0",
		"prettier": "^3.5.3",
		"storybook": "^10.6.7",
		"style-dictionary": "^4.3.3",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.3.8",
		"vite-plugin-dts": "^5.1.2",
		"vitest": "^5.1.0"
	}
}
