{
	"name": "@automattic/vip-design-system",
	"version": "3.0.0",
	"description": "A CSS/token-first design system for VIP projects",
	"license": "GPL-2.0-or-later",
	"type": "module",
	"main": "dist/index.cjs",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"require": "./dist/index.cjs",
			"types": "./dist/index.d.ts"
		},
		"./css": "./dist/css/index.css",
		"./tokens": "./dist/tokens/vars.css"
	},
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "npm run build:icons && npm run build:tokens && vite build",
		"build:icons": "node scripts/build-sprite.mjs",
		"build:tokens": "node style-dictionary.config.js",
		"dev": "storybook dev -p 6006",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"lint": "eslint src --ext .ts,.tsx --max-warnings 0",
		"lint:fix": "eslint src --ext .ts,.tsx --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"check-types": "tsc --noEmit"
	},
	"peerDependencies": {
		"react": "^18.0.0",
		"react-dom": "^18.0.0"
	},
	"dependencies": {
		"@boxicons/core": "^1.0.6",
		"@radix-ui/react-accordion": "^1.2.3",
		"@radix-ui/react-checkbox": "^1.1.4",
		"@radix-ui/react-collapsible": "^1.1.3",
		"@radix-ui/react-dialog": "^1.1.4",
		"@radix-ui/react-dropdown-menu": "^2.1.4",
		"@radix-ui/react-navigation-menu": "^1.2.3",
		"@radix-ui/react-switch": "^1.1.3",
		"@radix-ui/react-tabs": "^1.1.3",
		"@radix-ui/react-tooltip": "^1.1.6"
	},
	"devDependencies": {
		"@storybook/addon-a11y": "^10.3.3",
		"@storybook/addon-docs": "^10.3.3",
		"@storybook/addon-links": "^10.3.3",
		"@storybook/react-vite": "^10.3.3",
		"@testing-library/jest-dom": "^6.6.3",
		"@testing-library/react": "^16.3.0",
		"@testing-library/user-event": "^14.5.2",
		"@types/react": "^18.3.23",
		"@types/react-dom": "^18.3.7",
		"@typescript-eslint/eslint-plugin": "^7.18.0",
		"@typescript-eslint/parser": "^7.18.0",
		"@vitejs/plugin-react-swc": "^4.3.1",
		"@vitest/coverage-v8": "^3.2.0",
		"autoprefixer": "^10.4.21",
		"eslint": "^8.57.1",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^4.6.2",
		"jest-axe": "^9.0.0",
		"jsdom": "^26.1.0",
		"lefthook": "^1.11.13",
		"postcss": "^8.5.3",
		"postcss-import": "^16.1.0",
		"prettier": "^3.5.3",
		"storybook": "^10.3.3",
		"style-dictionary": "^4.3.3",
		"typescript": "^5.8.3",
		"vite": "^8.0.3",
		"vite-plugin-dts": "^4.5.4",
		"vitest": "^3.2.0"
	}
}
